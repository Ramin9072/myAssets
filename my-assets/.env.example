# کپی کنید به .env و در صورت نیاز تغییر دهید. مقادیر محرمانه را هرگز در مخزن عمومی قرار ندهید.

# پورت و آدرس سرور (پیش‌فرض: فقط روی همین رایانه در دسترس است)
PORT=8787
HOST=127.0.0.1

# پوشه ذخیره‌سازی assets.json و تاریخچه (پیش‌فرض: ./data)
DATA_DIR=./data

# آدرس پایه سرویس قیمت «نرخ‌سنج» (کلید نمی‌خواهد). فقط در صورت تغییر دامنه سرویس عوض کنید.
# PRICE_API_BASE_URL=https://nerkh.jahankhahan.shop

# برای ارائه‌دهنده‌های آینده که کلید API می‌خواهند (نرخ‌سنج به آن نیاز ندارد).
# مقدار واقعی را فقط در فایل .env محلی بگذارید، نه اینجا.
# PRICE_PROVIDER_API_KEY=

# --- فقط برای Vercel / استقرار آنلاین ---
# رمز ورود به برنامه (حتماً در Vercel تنظیم شود؛ بدون آن همه درخواست‌ها رد می‌شوند)
# APP_PASSWORD=
# اختیاری: کلید امضای نشست؛ اگر خالی باشد از APP_PASSWORD مشتق می‌شود
# SESSION_SECRET=
# پایگاه داده Upstash Redis: با افزودن Upstash از Storage/Marketplace در Vercel خودکار ساخته می‌شود
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
